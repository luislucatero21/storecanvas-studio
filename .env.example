# Optional managed (paid/workspace) AI gateway. Keep real values only in .env.local.
# The endpoint must accept OpenAI-compatible POST /chat/completions requests.
STORECANVAS_PLATFORM_AI_URL=
STORECANVAS_PLATFORM_AI_TOKEN=
STORECANVAS_PLATFORM_AI_MODEL=

# Optional managed connected-artwork image endpoint.
# Accepts an Images API-style request and returns data[0].b64_json or a public path.
STORECANVAS_PLATFORM_IMAGE_URL=
STORECANVAS_PLATFORM_IMAGE_TOKEN=
STORECANVAS_PLATFORM_IMAGE_MODEL=gpt-image-2

# Optional attribution header for OpenRouter requests.
STORECANVAS_PUBLIC_URL=
