# Optional local file sync for the editor, server renderer and CLI.
# A local app-store-screenshots.json is auto-loaded when present; set this only
# when you also want edits to write back to a specific file.
# STORECANVAS_PROJECT_FILE=app-store-screenshots.json

# Point this at a private project file in .env.local; do not commit that file.

# Optional attribution header for OpenRouter requests.
STORECANVAS_PUBLIC_URL=
